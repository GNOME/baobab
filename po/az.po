#: data/org.gnome.baobab.desktop.in:2 data/org.gnome.baobab.metainfo.xml.in:6
#: data/ui/baobab-main-window.ui:35 src/baobab-window.vala:262
msgid "Disk Usage Analyzer"
msgstr "Disk İstifadəsi Təhlilçisi"

#: data/org.gnome.baobab.desktop.in:3 data/org.gnome.baobab.metainfo.xml.in:7
msgid "Check folder sizes and available disk space"
msgstr "Qovluq ölçülərini və mövcud disk sahəsini yoxlayın"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.gnome.baobab.desktop.in:5
msgid "storage;space;cleanup;"
msgstr "saxlama;saxlanc;sahə;təmizlənmə;"

#: data/org.gnome.baobab.metainfo.xml.in:9
msgid ""
"A simple application to keep your disk usage and available space under "
"control."
msgstr ""
"Disk istifadənizi və mövcud sahənizi nəzarətdə saxlamaq üçün sadə bir tətbiq."

#: data/org.gnome.baobab.metainfo.xml.in:12
msgid ""
"Disk Usage Analyzer can scan specific folders, storage devices and online "
"accounts. It provides both a tree and a graphical representation showing the "
"size of each folder, making it easy to identify where disk space is wasted."
msgstr ""
"Disk İstifadəsi Təhlilçisi xüsusi qovluqları, saxlama cihazlarını və onlayn "
"hesabları skan edə bilər. Hər qovluğun ölçüsünü göstərən ağac və qrafik "
"təsvirlər təqdim edir ki, bu da disk sahəsinin harada israf olunduğunu "
"asanlıqla müəyyən etməyə imkan verir."

#: data/org.gnome.baobab.metainfo.xml.in:20
msgid "Devices and Locations View"
msgstr "Cihazlar və yerlər görünüşü"

#: data/org.gnome.baobab.metainfo.xml.in:24
